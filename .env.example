# Kaizen: The System
# Copy this file to .env and fill in your credentials.
# Never put real API keys or bot tokens in this example file.

# Discord Bot
DISCORD_TOKEN="your_discord_bot_token"
DISCORD_GUILD_ID=123456789012345678  # Optional: restrict to a specific guild

# Local FreeLLM OpenAI-compatible API
BASE_URL="http://localhost:3001/v1"
API_KEY="your_local_freellm_api_key"
# Optional. Leave blank to choose the first model returned by GET /v1/models.
MODEL=""

# Web Dashboard
WEB_HOST="127.0.0.1"
WEB_PORT=8001

# Game Loop / Schedule
DAILY_RESET_HOUR=0  # Midnight UTC
DAILY_REMINDER_HOUR=9  # Morning reminder
TIMEZONE="UTC"  # Set to your timezone (e.g., "America/New_York")
